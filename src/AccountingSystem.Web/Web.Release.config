<?xml version="1.0"?>
<!--
  Web.Release.config - XDT transform applied when publishing in Release.
  It turns off debug compilation and enables detailed error logging to the
  server trace while keeping custom errors on for clients.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>
    <compilation xdt:Transform="SetAttributes(debug)" debug="false" />
    <customErrors xdt:Transform="SetAttributes(mode)" mode="On" />
    <httpRuntime xdt:Transform="SetAttributes(enableVersionHeader)" enableVersionHeader="false" />
  </system.web>

</configuration>
