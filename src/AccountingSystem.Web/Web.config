<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  AccountingSystem.Web / Web.config
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Target: ASP.NET MVC 5 on .NET Framework 4.8, SQL Server Express Edition.

  Connection strings
  ~~~~~~~~~~~~~~~~~~
  The application reads its connection string by name:
      ConfigurationManager.ConnectionStrings["AccountingDbConnection"]
  (see AccountingSystem.Data/Context/DbConnectionFactory.cs).

  Only ONE <add name="AccountingDbConnection" ... /> may be active at a time.
  The alternatives below are commented out. Pick the one that matches your
  environment and uncomment it.

  Security guidance
  ~~~~~~~~~~~~~~~~~
  * Prefer Integrated Security (Windows authentication) so no password is ever
    stored in configuration.
  * When SQL authentication is unavoidable, never commit the real password.
    Encrypt the section with:
        aspnet_regiis -pe "connectionStrings" -app "/AccountingSystem" -prov "RsaProtectedConfigurationProvider"
    or inject it at deploy time from a secret store / environment variable.
  ============================================================================
-->
<configuration>

  <!--
    Entity Framework 6 registers its own configuration section. It is NOT
    declared in machine.config, so it must appear here before it is used below.
  -->
  <configSections>
    <section name="entityFramework"
             type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
             requirePermission="false" />
  </configSections>

  <!-- ======================= Connection strings ========================== -->
  <connectionStrings>

    <!--
      OPTION 1 (RECOMMENDED) - Windows Authentication / Integrated Security
      against a local SQL Server Express named instance.

      "Integrated Security=True" (equivalently "SSPI") means the process
      identity of the web application - the IIS application pool identity, or
      your Visual Studio account when running under IIS Express - is used to
      authenticate. No user name or password appears here.

      Grant the identity access with database/07_SecurityAndPermissions.sql.
    -->
    <add name="AccountingDbConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=AccountingSystemDB;Integrated Security=True;MultipleActiveResultSets=True;Application Name=AccountingSystem;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />

    <!--
      OPTION 1b - LocalDB (developer machines without a SQLEXPRESS instance).
      LocalDB is per-user; the server name is (localdb)\MSSQLLocalDB.
      Uncomment to use, and comment out Option 1.

      <add name="AccountingDbConnection"
           connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=AccountingSystemDB;Integrated Security=True;MultipleActiveResultSets=True;Application Name=AccountingSystem;Connect Timeout=30"
           providerName="System.Data.SqlClient" />
    -->

    <!--
      OPTION 2 - SQL Server Authentication against .\SQLEXPRESS.
      A dedicated, least-privilege SQL login (created by
      07_SecurityAndPermissions.sql). Replace the placeholder password and
      keep the real value out of source control.

      <add name="AccountingDbConnection"
           connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=AccountingSystemDB;User ID=AccountingUser;Password=YourSecurePassword;MultipleActiveResultSets=True;Application Name=AccountingSystem;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True"
           providerName="System.Data.SqlClient" />
    -->

    <!--
      OPTION 3 - Remote / named instance with a non-default port and a
      certificate-backed encrypted channel (production shape).

      <add name="AccountingDbConnection"
           connectionString="Data Source=tcp:sqlsrv01.example.internal,1433;Initial Catalog=AccountingSystemDB;Integrated Security=SSPI;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Application Name=AccountingSystem;Connect Timeout=30"
           providerName="System.Data.SqlClient" />
    -->

  </connectionStrings>

  <!-- ============================ App settings =========================== -->
  <appSettings>
    <!-- Application role definitions. Empty values mean "no Windows group is
         mapped to this role", so an unmapped user has no permissions. Set these
         to your Active Directory group names for a Windows-authenticated
         deployment, or leave them empty when a role provider supplies roles. -->
    <add key="Accounting:RoleMap:Administrator" value="" />
    <add key="Accounting:RoleMap:Accountant" value="" />
    <add key="Accounting:RoleMap:Approver" value="" />
    <add key="Accounting:RoleMap:Clerk" value="" />
    <add key="Accounting:RoleMap:Auditor" value="" />

    <!-- Development convenience only. When set, every authenticated user who is
         not matched by a RoleMap entry is treated as having this role. Leave
         empty in production. -->
    <add key="Accounting:DefaultRoleForAuthenticatedUsers" value="" />

    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- Functional settings -->
    <add key="Accounting:CompanyName" value="Example Company Ltd" />
    <add key="Accounting:BaseCurrency" value="USD" />
    <add key="Accounting:AllowPostingToClosedPeriod" value="false" />
    <add key="Accounting:RequireApprovalBeforePosting" value="true" />
    <add key="Accounting:JournalNumberPrefix" value="JV" />
    <add key="Accounting:DefaultArAccountCode" value="1100" />
    <add key="Accounting:DefaultApAccountCode" value="2100" />
    <add key="Accounting:DefaultTaxAccountCode" value="2200" />
    <add key="Accounting:DefaultBankAccountCode" value="1010" />
  </appSettings>

  <!-- ============================ System.web ============================= -->
  <system.web>
    <compilation debug="false" targetFramework="4.8" />

    <!--
      Request validation is on by default. Never disable it application-wide;
      validate and encode untrusted input at the point of use instead.
    -->
    <pages>
      <namespaces>
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="AccountingSystem.Web" />
      </namespaces>
    </pages>

    <!--
      Do not leak framework version or detailed errors to clients.
      Detailed errors are logged server-side, not rendered.
    -->
    <customErrors mode="On" defaultRedirect="~/Home/Error" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/Home/NotFound" />
      <error statusCode="403" redirect="~/Home/Forbidden" />
    </customErrors>

    <!--
      Harden cookies. Set requireSSL="true" once the site is served over HTTPS
      in every environment; it is left false here so the anti-forgery cookie
      still works under IIS Express over HTTP during development.
    -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <sessionState mode="InProc" timeout="20" cookieless="UseCookies" />
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>

    <!--
      Single httpRuntime element: .NET 4.8 target, no version header, and a
      modest upload cap to limit a large-POST denial-of-service surface.
    -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false"
                 maxRequestLength="20480" executionTimeout="120" />
  </system.web>

  <!-- ========================= system.webServer ========================= -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'self'" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <security>
      <requestFiltering>
        <!-- Block potentially dangerous upload extensions. -->
        <fileExtensions>
          <add fileExtension=".exe" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".dll" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- =========================== Entity Framework ======================== -->
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient"
                type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SqlClient" />
      <add name="SqlClient Data Provider"
           invariant="System.Data.SqlClient"
           description=".Net Framework Data Provider for SqlServer"
           type="System.Data.SqlClient.SqlClientFactory, System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    </DbProviderFactories>
  </system.data>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
